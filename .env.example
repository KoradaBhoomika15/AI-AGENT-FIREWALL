# GEMINI_API_KEY: Optional if integrating server-side Gemini analysis.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AI Agent Firewall - n8n Webhook Configuration
# Provide the webhook URL from your n8n workflow (e.g. Test Webhook or Production Webhook)
VITE_N8N_FIREWALL_WEBHOOK_URL="https://n8n.example.com/webhook/ai-agent-firewall"

# Server-enforced Security Policies
AUTHORIZED_COMPANY_EMAIL="security@shieldstore.internal"
ANONYMOUS_PURCHASE_LIMIT=3
DEFAULT_FIREWALL_MODE="demo"
